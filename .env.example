# =============================================================================
# Sentinel — environment template (copy to .env and fill in)
# Never commit real keys. Hackathon MVP uses a hot wallet for execution.
# =============================================================================

# --- Chain / wallet (execution agent) ---
CHAIN_ID=1
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
PRIVATE_KEY=0xYOUR_PRIVATE_KEY
WALLET_ADDRESS=0xYOUR_WALLET

# Preferred flight-to-safety assets (priority order)
SAFE_ASSETS=USDC,USDT,DAI
USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
USDT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7
DAI_ADDRESS=0x6B175474E89094C44Da98b954EedeAC495271d0F

# --- Uniswap Developer Platform API ---
# https://developers.uniswap.org/docs
UNISWAP_API_KEY=
UNISWAP_API_BASE_URL=https://api.uniswap.org/v1

# Positions / pools Sentinel should protect (comma-separated)
# Format: chainId:poolAddress or NFT position tokenIds for v3
WATCHED_POOLS=
WATCHED_POSITION_IDS=

# --- The Graph (token / pool monitoring) ---
# https://thegraph.com/blog/hackathon-resources/
GRAPH_GATEWAY_URL=
GRAPH_API_KEY=
# Optional: x402 pay-per-query (no API key)
GRAPH_X402_ENABLED=false
# Subgraph IDs / URLs for Uniswap + stablecoin feeds
GRAPH_UNISWAP_SUBGRAPH=
GRAPH_STABLECOIN_SUBGRAPH=

# --- 0G Compute (scanning / decision agent intelligence) ---
# https://docs.0g.ai/
ZG_COMPUTE_MODE=router
ZG_ROUTER_API_KEY=
ZG_ROUTER_BASE_URL=https://router-api.0g.ai/v1
ZG_MODEL=qwen/qwen-2.5-7b-instruct
# Direct SDK path (optional alternative to Router)
ZG_PRIVATE_KEY=
ZG_RPC_URL=https://evmrpc-testnet.0g.ai

# --- Security monitors ---
# Hexens Glider Monitor — https://hexens.io/solutions/glider-monitor
GLIDER_API_KEY=
GLIDER_WEBHOOK_SECRET=
GLIDER_PORTAL_URL=https://portal.hexens.io

# Forta (optional) — https://docs.forta.network/
FORTA_API_URL=https://api.forta.network/graphql
FORTA_API_KEY=

# Defimon (optional WebSocket exploit feed) — https://defimon.xyz/
DEFIMON_WS_URL=
DEFIMON_API_KEY=

# Hypernative / Guardrail / others (optional webhooks)
HYPERNATIVE_WEBHOOK_SECRET=
GUARDRAIL_WEBHOOK_SECRET=

# --- Agent runtime ---
# scanner = always-on risk agent; executor = separate process that acts
AGENT_ROLE=scanner
SCAN_INTERVAL_MS=15000
PRICE_DROP_THRESHOLD_PCT=15
DEPEG_THRESHOLD_BPS=100
# Require N independent signal sources before panic (reduces false positives)
PANIC_CONFIRMATIONS=2
# dry_run | live
EXECUTION_MODE=dry_run
# Shared queue / IPC between scanner and executor
REDIS_URL=
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
