# =============================================================================
# Sentinel — environment template (copy to .env and fill in)
# Never commit real keys. Hackathon MVP uses a hot wallet for execution.
# =============================================================================

# --- Chain / wallet (execution agent) ---
CHAIN_ID=1
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
PRIVATE_KEY=0xYOUR_PRIVATE_KEY
WALLET_ADDRESS=0xYOUR_WALLET

# Preferred flight-to-safety assets (priority order)
SAFE_ASSETS=USDC,USDT,DAI
USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
USDT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7
DAI_ADDRESS=0x6B175474E89094C44Da98b954EedeAC495271d0F
# After exit + swap, send stables here (must differ from WALLET_ADDRESS)
SAFE_WALLET_ADDRESS=

# ERC-20s to include in Graph portfolio polling (comma-separated)
PORTFOLIO_TOKENS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48,0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
# Extra USD-pegged tokens for depeg heuristics (optional)
PEGGED_TOKENS=

# --- Uniswap Developer Platform API ---
# https://developers.uniswap.org/docs
# Get a key from the Uniswap Developer Portal
UNISWAP_API_KEY=
UNISWAP_TRADE_API_BASE_URL=https://trade-api.gateway.uniswap.org/v1
UNISWAP_LP_API_BASE_URL=https://liquidity.api.uniswap.org

# Positions / pools Sentinel should protect (comma-separated)
WATCHED_POOLS=
WATCHED_POSITION_IDS=

# Optional Sepolia demo stable (sUSD) + Uniswap v3 pool vs USDC
# SUSD_ADDRESS=0xC084E80E4E546561f4348198ebfC1fe7b714DB37
# SUSD_USDC_POOL=0x68eB6856e570e2c33A7239D0fF8C5d9A77Cecd8b
# Pegged exit route (no wallet LP) — create via: pnpm exec tsx scripts/create-susd-usdt-exit-pool.ts
# SUSD_USDT_POOL=0x461e819226950FaAb9316AAc1E9967B6581dD8F0
# USDT_ADDRESS=0x7533aEe4bf76Fa0C761122a55dA08a09d24b109d
# Sepolia Circle USDC: 0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# When CHAIN_ID=11155111 set:
# USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# SAFE_ASSETS=USDC
# PORTFOLIO_TOKENS=<SUSD>,<USDC>
# WATCHED_POOLS=<SUSD_USDC_POOL>
# SAFE_WALLET_ADDRESS=0x...

# --- The Graph (token / pool monitoring) ---
# https://thegraph.com/blog/hackathon-resources/
GRAPH_GATEWAY_URL=https://gateway.thegraph.com/api
GRAPH_API_KEY=
# Uniswap v3 — Sepolia (default for this hackathon) / Mainnet alternative below
# Sepolia: CAfPFDcGEVpmGoEQf1LEvd4s3KkEPfHDBkmvcHmDsZuM
# Mainnet: 5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV
GRAPH_UNISWAP_SUBGRAPH=CAfPFDcGEVpmGoEQf1LEvd4s3KkEPfHDBkmvcHmDsZuM
GRAPH_X402_ENABLED=false

# --- 0G Compute ---
# https://docs.0g.ai/
ZG_COMPUTE_MODE=router
ZG_ROUTER_API_KEY=
ZG_ROUTER_BASE_URL=https://router-api-testnet.integratenetwork.work/v1
ZG_MODEL=qwen2.5-omni
ZG_SCORING_ENABLED=true
# Min gap between 0G model scoring calls (avoids 429s; no local heuristic fallback)
ZG_MIN_INTERVAL_MS=60000

# --- Security monitors ---
# Hexens Glider: point portal webhook to http://<host>:8787/hooks/glider
# Optional shared secret via header x-glider-secret
GLIDER_API_KEY=
GLIDER_WEBHOOK_SECRET=
FORTA_API_KEY=
FORTA_API_URL=https://api.forta.network/graphql
FORTA_POLL_ENABLED=false
DEFIMON_API_KEY=

# --- X / Twitter security intel (Blockaid et al.) ---
# https://x.com/blockaid_
# Prefer official X API v2 bearer token. Without it, scanner uses a local fixture.
X_BEARER_TOKEN=
X_WATCH_ACCOUNTS=blockaid_
X_POLL_ENABLED=true
X_MAX_POSTS=10
X_FIXTURE_PATH=

# --- Agent runtime ---
AGENT_ROLE=scanner
SCAN_INTERVAL_MS=15000
# Policy (stop-loss %, depeg bps, TVL drop, execution mode, stables, actions)
# is NOT set here — use the dashboard. Stored in data/runtime-settings.json
# locally, or Upstash Redis when the vars below are set.

# --- Shared cloud state (Upstash Redis) ---
# https://console.upstash.com → create Redis → REST API credentials
# Required for public Vercel demos (settings + live activity feed).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# PUBLIC_DEMO=true          # force dry-run simulation (auto on Vercel)
# ALLOW_PUBLIC_LIVE=true    # allow Config to stay on live when paired with a local agent
# ALLOW_PUBLIC_LIVE=false   # never enable on a public URL with a hot key
