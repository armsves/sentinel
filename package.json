{
  "name": "sentinel",
  "private": true,
  "version": "0.1.0",
  "description": "DeFi panic-button agent: Uniswap LP exit + Graph monitoring + 0G scoring",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev:scanner": "pnpm --filter @sentinel/scanner dev",
    "dev:executor": "pnpm --filter @sentinel/executor dev",
    "scanner": "pnpm --filter @sentinel/scanner start",
    "executor": "pnpm --filter @sentinel/executor start",
    "cli": "pnpm --filter @sentinel/executor start",
    "panic-worker": "pnpm --filter @sentinel/executor start panic-worker",
    "bot": "pnpm --filter @sentinel/bot start",
    "panic:simulate": "pnpm --filter @sentinel/executor start panic-simulate",
    "demo": "pnpm --filter @sentinel/executor start demo",
    "api": "pnpm --filter @sentinel/api start",
    "dashboard": "pnpm --filter @sentinel/dashboard dev",
    "typecheck": "pnpm -r run typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@sentinel/core": "workspace:*",
    "@sentinel/monitors": "workspace:*",
    "@sentinel/uniswap": "workspace:*",
    "@sentinel/zg": "workspace:*",
    "hono": "^4.7.5",
    "viem": "^2.28.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.8.2"
  }
}
