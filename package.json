{
  "name": "sentinel",
  "private": true,
  "version": "0.1.0",
  "description": "DeFi panic-button agent: Uniswap LP exit + Graph monitoring + 0G scoring",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev:scanner": "pnpm --filter @sentinel/scanner dev",
    "dev:executor": "pnpm --filter @sentinel/executor dev",
    "scanner": "pnpm --filter @sentinel/scanner start",
    "executor": "pnpm --filter @sentinel/executor start",
    "cli": "pnpm --filter @sentinel/executor start",
    "typecheck": "pnpm -r run typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.8.2"
  }
}
